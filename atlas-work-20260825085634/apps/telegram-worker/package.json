{
  "name": "@atlas/telegram-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/apps/telegram-worker/src/worker.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/fix-esm-extensions.mjs dist",
    "dev": "tsx watch src/worker.ts",
    "start": "node dist/apps/telegram-worker/src/worker.js",
    "start:production": "node dist/apps/telegram-worker/src/worker.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@atlas/shared": "workspace:*",
    "@aws-sdk/client-s3": "^3.705.0",
    "@aws-sdk/s3-request-presigner": "^3.705.0",
    "@prisma/client": "^6.1.0",
    "bullmq": "^5.34.5",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.2",
    "telegram": "^2.26.22",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
