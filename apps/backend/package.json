{
  "name": "@atlas/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/apps/backend/src/index.js",
  "scripts": {
    "build": "dotenv -e ../../.env -- prisma generate && tsc -p tsconfig.json && node ../../scripts/fix-esm-extensions.mjs dist",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/apps/backend/src/index.js",
    "start:production": "node dist/apps/backend/src/index.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "db:migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:migrate:status": "dotenv -e ../../.env -- prisma migrate status",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "admin:create": "dotenv -e ../../.env -- tsx src/scripts/admin-create.ts",
    "admin:reset": "dotenv -e ../../.env -- tsx src/scripts/admin-reset.ts",
    "admin:show": "dotenv -e ../../.env -- tsx src/scripts/admin-show.ts",
    "admin:cleanup-orphans": "dotenv -e ../../.env -- tsx src/scripts/admin-cleanup-orphans.ts",
    "fixtures:clean": "dotenv -e ../../.env -- tsx src/scripts/fixtures-clean.ts",
    "inbox:diagnostics": "dotenv -e ../../.env -- node scripts/inbox-diagnostics.mjs",
    "cleanup:telegram": "dotenv -e ../../.env -- node scripts/cleanup-telegram-service-chats.mjs"
  },
  "dependencies": {
    "@atlas/shared": "workspace:*",
    "@aws-sdk/client-s3": "^3.705.0",
    "@aws-sdk/s3-request-presigner": "^3.705.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/websocket": "^11.0.1",
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.5",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "pino": "^9.5.0",
    "resend": "^6.18.1",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "dotenv-cli": "^7.4.4",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
