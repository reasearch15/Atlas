generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLATFORM_ADMIN
  COADMIN
  STAFF
}

enum UserStatus {
  ACTIVE
  PENDING_PASSWORD_CHANGE
  SUSPENDED
  ARCHIVED
  DISABLED
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum PlatformAdminStatus {
  ACTIVE
  DISABLED
}

enum AdminLoginChallengePurpose {
  NEW_DEVICE
}

enum DeveloperAppProvider {
  TELEGRAM
}

enum DeveloperAppStatus {
  ACTIVE
  DISABLED
}

enum TelegramAccountStatus {
  PENDING
  AUTHORIZING
  WAITING_FOR_QR
  WAITING_FOR_PHONE
  WAITING_FOR_CODE
  WAITING_FOR_PASSWORD
  SYNCING
  CONNECTED
  DEGRADED
  REAUTH_REQUIRED
  DISCONNECTED
  FAILED
  DELETING
}

enum TelegramAuthorizationState {
  EMPTY
  QR_REQUESTED
  PHONE_REQUESTED
  CODE_REQUESTED
  PASSWORD_REQUESTED
  AUTHORIZED
  EXPIRED
  CANCELLED
  REAUTH_REQUIRED
}

enum TelegramSyncState {
  IDLE
  INITIAL_SYNC
  LIVE
  PAUSED
  FAILED
}

enum TelegramChatType {
  PRIVATE
  GROUP
  SUPERGROUP
  CHANNEL
  UNKNOWN
}

enum TelegramMessageDirection {
  INBOUND
  OUTBOUND
}

enum TelegramMessageContentType {
  TEXT
  PHOTO
  VIDEO
  VIDEO_NOTE
  VOICE
  AUDIO
  DOCUMENT
  ANIMATION
  STICKER
  CONTACT
  LOCATION
  LIVE_LOCATION
  POLL
  DICE
  OTHER
}

enum TelegramMediaDownloadState {
  NONE
  PENDING
  DOWNLOADING
  STORED
  FAILED
  SKIPPED
  UNAVAILABLE
}

enum TelegramSendStatus {
  RECEIVED
  QUEUED
  UPLOADING
  SENDING
  SENT
  DELIVERED
  FAILED_RETRYABLE
  FAILED_PERMANENT
}

enum TelegramOutboundOperation {
  SEND_TEXT_MESSAGE
  SEND_MEDIA_MESSAGE
  START_AUTH
  SUBMIT_PHONE
  SUBMIT_CODE
  SUBMIT_PASSWORD
  CANCEL_AUTH
  DISCONNECT
  REAUTHORIZE
  INITIAL_SYNC
  MEDIA_BACKFILL
  PERMANENT_DELETE
  MARK_CHAT_READ
  DELETE_MESSAGE
}

enum TelegramDeletionScope {
  EVERYONE
  ATLAS_ONLY
}

enum TelegramDeleteStatus {
  NONE
  QUEUED
  DELETING
  DELETED
  FAILED
}

enum TelegramAccountDeletionStage {
  REQUESTED
  STOPPING_WORKER
  DELETING_DATABASE
  DELETING_MEDIA
  COMPLETED
  FAILED
}

enum TelegramOutboundStatus {
  QUEUED
  SENDING
  SENT
  FAILED_RETRYABLE
  FAILED_PERMANENT
  CANCELLED
}

enum CrmConversationStatus {
  NEW
  OPEN
  WAITING
  RESOLVED
  CLOSED
}

enum CrmContactKind {
  PRIVATE
  GROUP
  CHANNEL
  UNKNOWN
}

enum CrmActivityType {
  CLAIMED
  ASSIGNED
  REASSIGNED
  RELEASED
  STATUS_CHANGED
  TAG_ADDED
  TAG_REMOVED
  NOTE_CREATED
  NOTE_EDITED
  REOPENED
  TELEGRAM_MESSAGE_SENT
  INTERNAL_MESSAGE_SENT
}

enum PushPlatform {
  ANDROID
  WEB
  IOS
}

enum NotificationType {
  INCOMING_MESSAGE
  NEW_CONVERSATION
  CONVERSATION_ASSIGNED
  CONVERSATION_REASSIGNED
  MENTION
  CONVERSATION_REOPENED
  URGENT_FLAG
  SLA_WARNING
  FAILED_MESSAGE
  INCOMING_CALL
  TEST
}

enum NotificationDeliveryStatus {
  QUEUED
  DISPATCHING
  SENT
  DELIVERED
  OPENED
  DISMISSED
  FAILED
  RETRY_SCHEDULED
  EXPIRED
  CANCELLED
  SKIPPED
  INVALID_TOKEN
}

enum LeaderboardCompetitionStatus {
  SCHEDULED
  ACTIVE
  FROZEN
  FINALIZED
  CANCELLED
}

enum LeaderboardEventType {
  DEPOSIT
  DEPOSIT_REVERSAL
  REFERRAL_MILESTONE
  REFERRAL_MILESTONE_REVERSAL
  PROMOTION
  PROMOTION_REVERSAL
  MANUAL_ADJUSTMENT
}

enum ReferralMilestoneCode {
  FIRST_10
  CUM_50
  CUM_100
  CUM_250
}

enum ReferralMilestoneAwardStatus {
  ACTIVE
  REVERSED
}

enum GiveawayPayoutStatus {
  UNPAID
  PAID
  VOID
}

enum PrizeMembershipStatus {
  ELIGIBLE
  NOT_ELIGIBLE
  PENDING_REVIEW
}

enum LeaderboardEligibilityVerificationSource {
  MANUAL
  TELEGRAM_BOT_API
}

enum LeaderboardTelegramJobType {
  REFRESH_PUBLIC_LEADERBOARD
  POST_RANK_ANNOUNCEMENT
  VERIFY_MEMBERSHIP
  POST_PUBLIC_RESULTS
}

enum LeaderboardTelegramJobStatus {
  QUEUED
  DISPATCHING
  SUCCEEDED
  RETRY_SCHEDULED
  FAILED
  CANCELLED
}

model Workspace {
  id               String                    @id @default(uuid()) @db.Uuid
  name             String                    @db.VarChar(120)
  slug             String                    @unique @db.VarChar(64)
  displayName      String?                   @map("display_name") @db.VarChar(120)
  adminNotes       String?                   @map("admin_notes") @db.Text
  status           WorkspaceStatus           @default(ACTIVE)
  primaryCoadminId String?                   @unique @map("primary_coadmin_id") @db.Uuid
  isDevelopmentFixture Boolean                @default(false) @map("is_development_fixture")
  fixtureKey      String?                    @unique @map("fixture_key") @db.VarChar(120)
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")
  users            User[]
  sessions         Session[]
  auditLogs        AuditLog[]
  telegramAccounts TelegramAccount[]
  developerApps    DeveloperApp[]
  telegramChats    TelegramChat[]
  telegramMessages TelegramMessage[]
  telegramCommands TelegramOutboundCommand[]
  primaryCoadmin   User?                     @relation("PrimaryWorkspaceCoadmin", fields: [primaryCoadminId], references: [id], onDelete: SetNull)
  crmContacts      CrmContact[]
  workspaceTags    WorkspaceTag[]
  crmNotes         CrmInternalNote[]
  crmActivities   CrmActivityEvent[]
  crmStatusHistory CrmStatusHistory[]
  internalThreads  InternalMessageThread[]
  internalMessages InternalMessage[]
  telegramAccountDeletions TelegramAccountDeletion[]
  pushDeviceTokens PushDeviceToken[]
  notificationPreferences NotificationPreference[]
  notificationDeliveryLogs NotificationDeliveryLog[]
  pushNotifications PushNotification[]
  leaderboardSettings LeaderboardSettings[]
  leaderboardCompetitions LeaderboardCompetition[]
  leaderboardEvents LeaderboardEvent[]
  leaderboardStandings LeaderboardStanding[]
  leaderboardReferrals LeaderboardReferral[]
  leaderboardPlayerStats LeaderboardPlayerStats[]
  leaderboardParticipants LeaderboardParticipant[]
  referralMilestoneAwards ReferralMilestoneAward[]
  promotionAwards PromotionAward[]
  poolRateHistory PoolRateHistory[]
  competitionSnapshots CompetitionSnapshot[]
  giveawayPayouts GiveawayPayout[]
  giveawayEligibilityCandidates GiveawayEligibilityCandidate[]
  leaderboardBotIntegrations LeaderboardBotIntegration[]
  leaderboardTelegramOutbox LeaderboardTelegramOutbox[]

  @@map("workspaces")
}

model User {
  id                      String                    @id @default(uuid()) @db.Uuid
  workspaceId             String?                   @map("workspace_id") @db.Uuid
  workspace               Workspace?                @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  email                   String?                   @unique @db.VarChar(320)
  username                String?                   @unique @db.VarChar(80)
  name                    String                    @db.VarChar(120)
  passwordHash            String                    @map("password_hash")
  passwordChangedAt       DateTime?                 @map("password_changed_at")
  temporaryPasswordIssuedAt DateTime?               @map("temporary_password_issued_at")
  mustChangePassword      Boolean                   @default(false) @map("must_change_password")
  role                    UserRole
  status                  UserStatus                @default(ACTIVE)
  isDevelopmentFixture    Boolean                   @default(false) @map("is_development_fixture")
  fixtureKey              String?                   @unique @map("fixture_key") @db.VarChar(120)
  createdAt               DateTime                  @default(now()) @map("created_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")
  sessions                Session[]
  auditLogs               AuditLog[]                @relation("ActorAuditLogs")
  createdTelegramAccounts TelegramAccount[]         @relation("CreatedTelegramAccounts")
  createdDeveloperApps    DeveloperApp[]            @relation("CreatedDeveloperApps")
  sentTelegramMessages    TelegramMessage[]         @relation("InternalTelegramMessages")
  deletedTelegramMessages TelegramMessage[]         @relation("DeletedTelegramMessages")
  telegramCommands        TelegramOutboundCommand[] @relation("RequestedTelegramCommands")
  ownedWorkspace           Workspace?                @relation("PrimaryWorkspaceCoadmin")
  platformAdmin           PlatformAdmin?
  trustedDevices           UserTrustedDevice[]
  assignedTelegramChats    TelegramChat[]            @relation("ChatAssignee")
  assignmentActorChats     TelegramChat[]            @relation("ChatAssignedBy")
  crmNotesAuthored         CrmInternalNote[]         @relation("CrmNoteAuthor")
  crmActivitiesActed       CrmActivityEvent[]        @relation("CrmActivityActor")
  crmStatusChanges        CrmStatusHistory[]        @relation("CrmStatusActor")
  tagsCreated              WorkspaceTag[]            @relation("TagCreator")
  chatTagsAdded            TelegramChatTag[]         @relation("ChatTagAdder")
  staffInternalThreads     InternalMessageThread[]   @relation("InternalThreadStaff")
  sentInternalMessages     InternalMessage[]         @relation("InternalMessageSender")
  receivedInternalMessages InternalMessage[]         @relation("InternalMessageReceiver")
  telegramAccountDeletions TelegramAccountDeletion[] @relation("TelegramAccountDeletionActor")
  pushDeviceTokens         PushDeviceToken[]
  notificationPreference   NotificationPreference?
  notificationDeliveryLogs NotificationDeliveryLog[]
  pushNotifications        PushNotification[]
  leaderboardSettingsUpdated LeaderboardSettings[] @relation("LeaderboardSettingsUpdatedBy")
  leaderboardCompetitionsFinalized LeaderboardCompetition[] @relation("LeaderboardCompetitionFinalizedBy")
  leaderboardEventsActed   LeaderboardEvent[] @relation("LeaderboardEventActor")
  leaderboardReferralsCreated LeaderboardReferral[] @relation("LeaderboardReferralCreatedBy")
  leaderboardReferralsOverridden LeaderboardReferral[] @relation("LeaderboardReferralOverriddenBy")
  promotionAwardsActed     PromotionAward[] @relation("PromotionAwardActor")
  poolRateHistoryChanged   PoolRateHistory[] @relation("PoolRateHistoryChangedBy")
  giveawayPayoutsMarked    GiveawayPayout[] @relation("GiveawayPayoutMarkedBy")
  giveawayEligibilityResolved GiveawayEligibilityCandidate[] @relation("GiveawayEligibilityResolvedBy")
  ownedLeaderboardSettings LeaderboardSettings[] @relation("LeaderboardSettingsOwner")
  ownedLeaderboardCompetitions LeaderboardCompetition[] @relation("LeaderboardCompetitionOwner")
  ownedLeaderboardEvents LeaderboardEvent[] @relation("LeaderboardEventOwner")
  ownedLeaderboardStandings LeaderboardStanding[] @relation("LeaderboardStandingOwner")
  ownedLeaderboardReferrals LeaderboardReferral[] @relation("LeaderboardReferralOwner")
  ownedLeaderboardPlayerStats LeaderboardPlayerStats[] @relation("LeaderboardPlayerStatsOwner")
  ownedLeaderboardParticipants LeaderboardParticipant[] @relation("LeaderboardParticipantOwner")
  createdLeaderboardParticipants LeaderboardParticipant[] @relation("LeaderboardParticipantCreatedBy")
  ownedPromotionAwards PromotionAward[] @relation("PromotionAwardOwner")
  ownedPoolRateHistory PoolRateHistory[] @relation("PoolRateHistoryOwner")
  ownedCompetitionSnapshots CompetitionSnapshot[] @relation("CompetitionSnapshotOwner")
  ownedGiveawayPayouts GiveawayPayout[] @relation("GiveawayPayoutOwner")
  ownedGiveawayEligibilityCandidates GiveawayEligibilityCandidate[] @relation("GiveawayEligibilityOwner")
  ownedLeaderboardBotIntegrations LeaderboardBotIntegration[] @relation("LeaderboardBotIntegrationOwner")
  ownedLeaderboardTelegramOutbox LeaderboardTelegramOutbox[] @relation("LeaderboardTelegramOutboxOwner")

  @@index([username])
  @@index([workspaceId, role])
  @@map("users")
}

model UserTrustedDevice {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash")
  displayName     String    @map("display_name") @db.VarChar(160)
  browser         String    @db.VarChar(80)
  operatingSystem String    @map("operating_system") @db.VarChar(80)
  firstIp         String    @map("first_ip") @db.Inet
  lastIp          String    @map("last_ip") @db.Inet
  firstTrustedAt  DateTime  @default(now()) @map("first_trusted_at")
  lastUsedAt      DateTime  @default(now()) @map("last_used_at")
  expiresAt       DateTime  @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions        Session[]

  @@index([userId, revokedAt, expiresAt])
  @@map("user_trusted_devices")
}

model PlatformAdmin {
  id                String                @id @default(uuid()) @db.Uuid
  userId            String                @unique @map("user_id") @db.Uuid
  email             String                @unique @db.VarChar(320)
  passwordHash      String                @map("password_hash")
  status            PlatformAdminStatus   @default(ACTIVE)
  passwordChangedAt DateTime              @default(now()) @map("password_changed_at")
  lastLoginAt       DateTime?             @map("last_login_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenges        AdminLoginChallenge[]
  trustedDevices    AdminTrustedDevice[]

  @@map("platform_admins")
}

model AdminLoginChallenge {
  id                  String                     @id @default(uuid()) @db.Uuid
  adminId             String                     @map("admin_id") @db.Uuid
  codeHash            String                     @map("code_hash")
  purpose             AdminLoginChallengePurpose @default(NEW_DEVICE)
  expiresAt           DateTime                   @map("expires_at")
  failedAttempts      Int                        @default(0) @map("failed_attempts")
  maxAttempts         Int                        @default(5) @map("max_attempts")
  consumedAt          DateTime?                  @map("consumed_at")
  createdAt           DateTime                   @default(now()) @map("created_at")
  lastSentAt          DateTime                   @default(now()) @map("last_sent_at")
  requestingIp        String                     @map("requesting_ip") @db.Inet
  requestingUserAgent String                     @map("requesting_user_agent")
  admin               PlatformAdmin              @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, purpose, consumedAt, expiresAt])
  @@map("admin_login_challenges")
}

model AdminTrustedDevice {
  id                  String        @id @default(uuid()) @db.Uuid
  adminId             String        @map("admin_id") @db.Uuid
  tokenHash           String        @unique @map("token_hash")
  displayName         String        @map("display_name") @db.VarChar(160)
  browser             String        @db.VarChar(80)
  operatingSystem     String        @map("operating_system") @db.VarChar(80)
  firstIp             String        @map("first_ip") @db.Inet
  lastIp              String        @map("last_ip") @db.Inet
  firstTrustedAt      DateTime      @default(now()) @map("first_trusted_at")
  lastUsedAt          DateTime      @default(now()) @map("last_used_at")
  expiresAt           DateTime      @map("expires_at")
  revokedAt           DateTime?     @map("revoked_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  admin               PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  sessions            Session[]

  @@index([adminId, revokedAt, expiresAt])
  @@map("admin_trusted_devices")
}

model DeveloperApp {
  id               String               @id @default(uuid()) @db.Uuid
  workspaceId      String               @map("workspace_id") @db.Uuid
  provider         DeveloperAppProvider
  displayName      String               @map("display_name") @db.VarChar(120)
  apiId            Int                  @map("api_id")
  encryptedApiHash Json                 @map("encrypted_api_hash")
  status           DeveloperAppStatus   @default(ACTIVE)
  isDevelopmentFixture Boolean           @default(false) @map("is_development_fixture")
  fixtureKey       String?              @unique @map("fixture_key") @db.VarChar(120)
  createdByUserId  String               @map("created_by") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  deletedAt        DateTime?            @map("deleted_at")
  workspace        Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy        User                 @relation("CreatedDeveloperApps", fields: [createdByUserId], references: [id], onDelete: Restrict)
  telegramAccounts TelegramAccount[]

  @@unique([workspaceId, provider, displayName])
  @@index([workspaceId, provider, status])
  @@map("developer_apps")
}

model TelegramAccount {
  id                   String                     @id @default(uuid()) @db.Uuid
  workspaceId          String                     @map("workspace_id") @db.Uuid
  developerAppId       String                     @map("developer_app_id") @db.Uuid
  displayName          String                     @map("display_name") @db.VarChar(120)
  telegramUserId       String?                    @map("telegram_user_id") @db.VarChar(64)
  telegramUsername     String?                    @map("telegram_username") @db.VarChar(120)
  phoneNumberEncrypted Json?                      @map("phone_number_encrypted")
  sessionEncrypted     Json?                      @map("session_encrypted")
  status               TelegramAccountStatus      @default(PENDING)
  authorizationState   TelegramAuthorizationState @default(EMPTY) @map("authorization_state")
  syncState            TelegramSyncState          @default(IDLE) @map("sync_state")
  isDevelopmentFixture Boolean                    @default(false) @map("is_development_fixture")
  fixtureKey           String?                    @unique @map("fixture_key") @db.VarChar(120)
  lastConnectedAt      DateTime?                  @map("last_connected_at")
  lastUpdateAt         DateTime?                  @map("last_update_at")
  lastErrorCode        String?                    @map("last_error_code") @db.VarChar(80)
  lastErrorMessage     String?                    @map("last_error_message") @db.VarChar(500)
  workerLeaseOwner     String?                    @map("worker_lease_owner") @db.VarChar(120)
  workerLeaseExpiresAt DateTime?                  @map("worker_lease_expires_at")
  createdByUserId      String                     @map("created_by_user_id") @db.Uuid
  createdAt            DateTime                   @default(now()) @map("created_at")
  updatedAt            DateTime                   @updatedAt @map("updated_at")
  disconnectedAt       DateTime?                  @map("disconnected_at")
  workspace            Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  developerApp         DeveloperApp               @relation(fields: [developerAppId], references: [id], onDelete: Restrict)
  createdBy            User                       @relation("CreatedTelegramAccounts", fields: [createdByUserId], references: [id], onDelete: Restrict)
  chats                TelegramChat[]
  messages             TelegramMessage[]
  outboundCommands     TelegramOutboundCommand[]

  @@index([workspaceId, status])
  @@index([workspaceId, developerAppId])
  @@index([workerLeaseExpiresAt])
  @@map("telegram_accounts")
}

model TelegramChat {
  id                 String                    @id @default(uuid()) @db.Uuid
  workspaceId        String                    @map("workspace_id") @db.Uuid
  telegramAccountId  String                    @map("telegram_account_id") @db.Uuid
  telegramChatId     String                    @map("telegram_chat_id") @db.VarChar(80)
  chatType           TelegramChatType          @map("chat_type")
  title              String                    @db.VarChar(255)
  username           String?                   @db.VarChar(120)
  firstName          String?                   @map("first_name") @db.VarChar(120)
  lastName           String?                   @map("last_name") @db.VarChar(120)
  isBot              Boolean                   @default(false) @map("is_bot")
  photoMetadata      Json?                     @map("photo_metadata")
  lastMessageId      String?                   @map("last_message_id") @db.VarChar(80)
  lastMessagePreview String?                   @map("last_message_preview") @db.VarChar(500)
  lastMessageAt      DateTime?                 @map("last_message_at")
  unreadCount        Int                       @default(0) @map("unread_count")
  isPinned           Boolean                   @default(false) @map("is_pinned")
  isArchived         Boolean                   @default(false) @map("is_archived")
  /** Max Telegram message id acknowledged as read by Atlas (durable read boundary). */
  lastReadTelegramMessageId String?            @map("last_read_telegram_message_id") @db.VarChar(80)
  /** When Atlas last persisted a read acknowledgement for this chat. */
  lastReadAt         DateTime?                 @map("last_read_at")
  isDevelopmentFixture Boolean                 @default(false) @map("is_development_fixture")
  fixtureKey         String?                   @unique @map("fixture_key") @db.VarChar(120)
  rawMetadataJson    Json                      @default("{}") @map("raw_metadata_json")
  /** GramJS InputPeer access_hash as decimal string (required for USER/CHANNEL peers). */
  accessHash         String?                   @map("access_hash") @db.VarChar(80)
  /** USER | CHAT | CHANNEL — drives InputPeer construction. */
  peerType           String?                   @map("peer_type") @db.VarChar(16)
  /** Optional phone captured from User entity for resolution (not shown to Staff by default). */
  peerPhone          String?                   @map("peer_phone") @db.VarChar(32)
  crmContactId       String?                   @map("crm_contact_id") @db.Uuid
  crmStatus          CrmConversationStatus     @default(NEW) @map("crm_status")
  assignedUserId     String?                   @map("assigned_user_id") @db.Uuid
  assignedAt         DateTime?                 @map("assigned_at")
  assignedByUserId   String?                   @map("assigned_by_user_id") @db.Uuid
  claimedAt          DateTime?                 @map("claimed_at")
  lastAssignmentChangeAt DateTime?             @map("last_assignment_change_at")
  needsCrmAttention  Boolean                   @default(true) @map("needs_crm_attention")
  crmAttentionAt     DateTime?                 @map("crm_attention_at")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")
  workspace          Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  telegramAccount    TelegramAccount           @relation(fields: [telegramAccountId], references: [id], onDelete: Cascade)
  crmContact         CrmContact?               @relation(fields: [crmContactId], references: [id], onDelete: SetNull)
  assignedUser       User?                     @relation("ChatAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  assignedByUser     User?                     @relation("ChatAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  messages           TelegramMessage[]
  outboundCommands   TelegramOutboundCommand[]
  tags               TelegramChatTag[]
  notes              CrmInternalNote[]
  activities         CrmActivityEvent[]
  statusHistory      CrmStatusHistory[]

  @@unique([telegramAccountId, telegramChatId])
  @@index([workspaceId, lastMessageAt])
  @@index([workspaceId, telegramAccountId])
  @@index([workspaceId, crmStatus, assignedUserId])
  @@index([workspaceId, needsCrmAttention, lastMessageAt])
  @@index([assignedUserId])
  @@index([crmContactId])
  @@map("telegram_chats")
}

model CrmContact {
  id              String         @id @default(uuid()) @db.Uuid
  workspaceId     String         @map("workspace_id") @db.Uuid
  telegramPeerId  String         @map("telegram_peer_id") @db.VarChar(80)
  kind            CrmContactKind @default(UNKNOWN)
  displayName     String         @map("display_name") @db.VarChar(255)
  username        String?        @db.VarChar(120)
  phoneMasked     String?        @map("phone_masked") @db.VarChar(32)
  firstSeenAt     DateTime       @default(now()) @map("first_seen_at")
  lastSeenAt      DateTime       @default(now()) @map("last_seen_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chats           TelegramChat[]
  leaderboardEvents LeaderboardEvent[]
  leaderboardStandings LeaderboardStanding[]
  leaderboardReferralsAsReferrer LeaderboardReferral[] @relation("LeaderboardReferrer")
  leaderboardReferralsAsReferred LeaderboardReferral[] @relation("LeaderboardReferred")
  leaderboardPlayerStats LeaderboardPlayerStats[]
  leaderboardParticipants LeaderboardParticipant[]
  promotionAwards PromotionAward[]
  giveawayPayouts GiveawayPayout[]
  giveawayEligibilityCandidates GiveawayEligibilityCandidate[]

  @@unique([workspaceId, telegramPeerId])
  @@index([workspaceId, lastSeenAt])
  @@map("crm_contacts")
}

model WorkspaceTag {
  id              String            @id @default(uuid()) @db.Uuid
  workspaceId     String            @map("workspace_id") @db.Uuid
  name            String            @db.VarChar(80)
  color           String            @db.VarChar(16)
  archivedAt      DateTime?         @map("archived_at")
  createdByUserId String?           @map("created_by_user_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy       User?             @relation("TagCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
