################################################################################
# Atlas production environment template — KEY NAMES AND PLACEHOLDERS ONLY.
# Copy to /opt/atlas/shared/.env on the VPS. Never commit real values.
#
# Categories:
#   [SECRET]              — treat as credentials; rotate carefully
#   [MIGRATION-IDENTICAL] — must match the source environment during cutover or
#                           Telegram sessions / JWTs become undecryptable/invalid
#   [BUILD-TIME]          — baked into Next.js client bundle at `pnpm build`
#   [RUNTIME]             — read when processes start
#   [DEV-ONLY]            — must stay disabled in production
################################################################################

# --- Runtime / process --------------------------------------------------------
# [RUNTIME] development | test | production
NODE_ENV=production

# --- Shared required ----------------------------------------------------------
# [SECRET] [RUNTIME] [MIGRATION-IDENTICAL for existing DB users if you keep sessions]
DATABASE_URL=postgresql://atlas:CHANGE_ME@127.0.0.1:5432/atlas?schema=public

# [SECRET] [RUNTIME]
REDIS_URL=redis://127.0.0.1:6379

# [RUNTIME] S3-compatible endpoint (MinIO or managed S3/R2)
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=atlas
# [SECRET]
S3_ACCESS_KEY_ID=CHANGE_ME_ACCESS_KEY
# [SECRET]
S3_SECRET_ACCESS_KEY=CHANGE_ME_SECRET_KEY

# [SECRET] [RUNTIME] [MIGRATION-IDENTICAL] min length 64
# Changing this during migration permanently invalidates Telegram sessionEncrypted rows.
TELEGRAM_SESSION_ENCRYPTION_KEY=CHANGE_ME_TO_AT_LEAST_64_RANDOM_CHARACTERS________________

# [SECRET] [RUNTIME] [MIGRATION-IDENTICAL if you want existing refresh cookies to keep working]
# min length 64
JWT_ACCESS_SECRET=CHANGE_ME_TO_AT_LEAST_64_RANDOM_CHARACTERS_FOR_ACCESS________________
JWT_REFRESH_SECRET=CHANGE_ME_TO_AT_LEAST_64_RANDOM_CHARACTERS_FOR_REFRESH_______________

# [RUNTIME] exact browser origin (scheme + host + optional port). Must be https in production.
FRONTEND_ORIGIN=https://ATLAS_DOMAIN

# --- Backend-specific ---------------------------------------------------------
# [RUNTIME] listen address / port (code uses BACKEND_HOST + BACKEND_PORT; there is no PORT key)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=4000

# [RUNTIME] production validation requires COOKIE_SECURE=true
COOKIE_SECURE=true
# [RUNTIME] production validation forbids "localhost"; use parent domain for cookies, e.g. .example.com
COOKIE_DOMAIN=.example.com

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
ADMIN_VERIFICATION_TTL_SECONDS=600
ADMIN_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
ADMIN_TRUSTED_DEVICE_TTL_SECONDS=2592000

# [RUNTIME] currently only "resend" is supported by the schema
EMAIL_PROVIDER=resend
# [SECRET]
RESEND_API_KEY=re_CHANGE_ME
EMAIL_FROM=Atlas Security <security@example.com>

# Optional bootstrap helpers (prefer interactive admin:create in production)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# [DEV-ONLY] [RUNTIME] production validation requires false
ENABLE_DEV_FIXTURES=false

# --- Worker-specific ----------------------------------------------------------
# [RUNTIME] unique per worker instance
TELEGRAM_WORKER_ID=telegram-worker-1
TELEGRAM_LEASE_SECONDS=45

# --- Frontend-specific --------------------------------------------------------
# [BUILD-TIME] public API origin used by the browser (and derived WebSocket base).
# Same-domain recommendation: https://ATLAS_DOMAIN
# Split-domain alternative: https://ATLAS_API_DOMAIN
# WebSocket URL is derived automatically: http→ws / https→wss + "/ws" (no separate WS env var).
NEXT_PUBLIC_API_URL=https://platform.atlast.work
